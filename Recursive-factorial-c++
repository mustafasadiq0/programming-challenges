#include <iostream>
using namespace std;

int FirstFactorial(int num) { int i,fact=1; 

  for (i=1;i<=num;i++)
  fact=fact*i;
  
  return fact; 
            
}

int main() { 
  
  // keep this function call here
  cout << FirstFactorial(gets(stdin));  //here you will be asked to enter the number that you want its factorial
  return 0;
    
}
